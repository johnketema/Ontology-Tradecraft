@prefix : <http://project2.org/ontology#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<http://project2.org/ontology/instances>
    a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:comment "Instances for Project 2, defining fundamental classes and properties."^^xsd:string ;
    rdfs:label "Airplane Specification Ontology Instances"^^xsd:string ;
    owl:versionInfo "1.0.0"^^xsd:string .

# Task 1 compliant instances

:Airbus a :Manufacturer ;
    rdfs:label "Airbus"^^xsd:string ;
    skos:definition "A European multinational aerospace corporation that designs, manufactures, and sells civil and military aeronautical products worldwide."^^xsd:string .

:Jet_Engine_1 a :Jet_Engine ;
    rdfs:label "CFM International LEAP-1A"^^xsd:string ;
    skos:definition "A high-bypass turbofan engine developed by CFM International, used in the Airbus A320 NEO family."^^xsd:string .

:Jet_Engine_2 a :Jet_Engine ;
    rdfs:label "CFM International LEAP-1A"^^xsd:string ;
    skos:definition "A high-bypass turbofan engine developed by CFM International, used in the Airbus A320 NEO family."^^xsd:string .

:Airbus_A320_NEO_Spec a :Artifact_Design ;
    rdfs:label "Airbus A320 NEO Specification"^^xsd:string ;
    skos:definition "A detailed description of the characteristics and features of the Airbus A320 NEO jet"^^xsd:string ;
    :is_about :Airbus_A320_NEO .

:Airbus_A320_NEO a :Fixed_Wing ;
    rdfs:label "Airbus A320 NEO"^^xsd:string ;
    skos:definition "A member of the Airbus A320 family of aircraft, featuring new engine options and improved aerodynamics for enhanced fuel efficiency."^^xsd:string ;
    :has_continuant_part :Jet_Engine_1, :Jet_Engine_2 ;
    :has_Model_BADA "BADA 4.2"^^xsd:string ;
    :has_Model_FAA "FAA Type Certificate A16NM"^^xsd:string ;
    :has_Length_Ft "123.3"^^xsd:decimal ;
    :has_Tail_HeightFt "38.7"^^xsd:decimal ;
    :has_Airplane_Class :Fixed_Wing ;
    :has_Manufacturer :Airbus .

# Task 2 compliant instances

:Airbus_A321_111 a :Fixed_Wing ;
    rdfs:label "Airbus A321-111"^^xsd:string ;
    skos:definition "A specific variant of the Airbus A321, featuring a single-aisle design and optimized for short to medium-haul flights."^^xsd:string .

:Airbus_A321_111_Spec a :Artifact_Design ;
    rdfs:label "Airbus A321-111 Specification"^^xsd:string ;
    skos:definition "A detailed description of the characteristics and features of the Airbus A321 jet"^^xsd:string ;
    :is_about :Airbus_A321_111 .

:Test_Process_1 a :Test_Process ;
    rdfs:label "Airbus A320 NEO Approach Performance Test"^^xsd:string ;
    skos:definition "A test process designed to evaluate the approach performance of the Airbus A320 NEO under specific conditions."^^xsd:string .

:Knot a :Measurement_Unit ;
    rdfs:label "Knot"^^xsd:string ;
    skos:definition "A unit of speed equal to one nautical mile per hour, commonly used in aviation."^^xsd:string ;
    :is_measurement_unit_of :Approach_Measurement_139_1 ;
    :is_measurement_unit_of :Approach_Measurement_139_2 ;
    :is_measurement_unit_of :Approach_Measurement_139_3 ;
    :is_measurement_unit_of :Approach_Measurement_139_4 ;
    :is_measurement_unit_of :Approach_Measurement_139_5 ;
    :is_measurement_unit_of :Approach_Measurement_142 .

:Approach_Measurement_142 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 142"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "142"^^xsd:integer .

:Approach_Measurement_139_1 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 139"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "139"^^xsd:integer ;
    :is_temporal_part_of :Test_Process_1 .

:Approach_Measurement_139_2 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 139"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "139"^^xsd:integer ;
    :is_temporal_part_of :Test_Process_1 .

:Approach_Measurement_139_3 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 139"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "139"^^xsd:integer ;
    :is_temporal_part_of :Test_Process_1 .

:Approach_Measurement_139_4 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 139"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "139"^^xsd:integer ;
    :is_temporal_part_of :Test_Process_1 .

:Approach_Measurement_139_5 a :Approach_Measurement ;
    rdfs:label "Approach Measurement 139"^^xsd:string ;
    skos:definition "A specific approach measurement test process for the Airbus A320 NEO, measuring approach performance under defined conditions."^^xsd:string ;
    rdf:value "139"^^xsd:integer ;
    :is_temporal_part_of :Test_Process_1 .

:Airbus_A321_111_Spec :prescribes :Approach_Measurement_142 .



