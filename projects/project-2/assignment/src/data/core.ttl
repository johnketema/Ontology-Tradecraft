@prefix : <http://project2.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix BFO: <http://purl.obolibrary.org/obo/BFO_> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<http://project2.org/ontology/core>
    a owl:Ontology ;
    owl:imports <http://purl.obolibrary.org/obo/bfo/2020/bfo-core.owl> ;
    rdfs:comment "Core ontology for Project 2, defining fundamental classes and properties."^^xsd:string ;
    rdfs:label "Airplane Specification Ontology"^^xsd:string ;
    owl:versionInfo "1.0.0"^^xsd:string .

:Airplane a owl:Class ;
    rdfs:label "Airplane"^^xsd:string ;
    skos:definition "A powered, heavier-than-air aircraft with fixed wings that generates lift through forward motion."^^xsd:string ;
    rdfs:subClassOf BFO:0000040 .  # BFO:0000040 represents 'Material Entity'    

# Task 1 - include Artifact Design, Jet Engine, Fixed Wing, has continuant part, has Model BADA, has Model FAA, has Length Ft, has Tail HeightFt, is about
BFO:0000015 a owl:Class ;
    rdfs:label "process"^^xsd:string ;
    skos:definition "A temporal entity that unfolds over time."^^xsd:string .

BFO:0000040 a owl:Class ;
    rdfs:label "material entity"^^xsd:string ;
    skos:definition "An entity that has some portion of matter as part."^^xsd:string .

BFO:0000031 a owl:Class ;
    rdfs:label "generically dependent continuant"^^xsd:string ;
    skos:definition "An entity that depends generically on another entity."^^xsd:string .

BFO:0000015 a owl:Class ;
    rdfs:label "process"^^xsd:string ;
    skos:definition "A temporal entity that unfolds over time."^^xsd:string .

:Artifact_Design a owl:Class ;
    rdfs:label "Artifact Design"^^xsd:string ;
    skos:definition "A detailed description of the characteristics and features of an artifact."^^xsd:string ;
    rdfs:subClassOf BFO:0000031 .  # BFO:0000031 represents 'Generically Dependent Continuant'

:is_about a owl:ObjectProperty ;
    rdfs:label "is about"^^xsd:string ;
    skos:definition "Relates an information content entity to the entity it is about."^^xsd:string .

:Jet_Engine a owl:Class ;
    rdfs:label "Jet Engine"^^xsd:string ;
    skos:definition "A type of reaction engine that discharges a fast-moving jet of fluid to generate thrust in accordance with Newton's third law of motion."^^xsd:string ;
    rdfs:subClassOf BFO:0000040 .  # BFO:0000040 represents 'Material Entity'

:has_continuant_part a owl:ObjectProperty ;
    rdfs:label "has continuant part"^^xsd:string ;
    skos:definition "Relates an entity to its continuant parts."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range BFO:0000002 .  # BFO:0000002 represents 'Continuant' 

:Airplane_Class a owl:Class ;
    rdfs:label "Airplane Class"^^xsd:string ;
    skos:definition "A category of airplanes based on shared characteristics or features."^^xsd:string ;
    rdfs:subClassOf BFO:0000040 .  # BFO:0000040 represents 'Material Entity'

:Fixed_Wing a owl:Class ;
    rdfs:label "Fixed Wing"^^xsd:string ;
    skos:definition "An aircraft that has a wing that is rigid and does not move relative to the main body of the aircraft."^^xsd:string ;
    rdfs:subClassOf :Airplane_Class .

:has_Airplane_Class a owl:ObjectProperty ;
    rdfs:label "has Airplane Class"^^xsd:string ;
    skos:definition "Relates an airplane to the class of airplane it is"^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range :Airplane_Class .

:has_Model_BADA a owl:DatatypeProperty ;
    rdfs:label "has Model BADA"^^xsd:string ;
    skos:definition "Relates an airplane to its BADA model."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range xsd:string .

:has_Length_Ft a owl:DatatypeProperty ;
    rdfs:label "has Length Ft"^^xsd:string ;
    skos:definition "The length of an airplane in feet."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range xsd:decimal .

:has_Tail_HeightFt a owl:DatatypeProperty ;
    rdfs:label "has Tail Height Ft"^^xsd:string ;
    skos:definition "The tail height of an airplane in feet."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range xsd:decimal .

:has_Model_FAA a owl:DatatypeProperty ;
    rdfs:label "has Model FAA"^^xsd:string ;
    skos:definition "Relates an airplane to its FAA model."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range xsd:string .

:Manufacturer a owl:Class ;
    rdfs:label "Manufacturer"^^xsd:string ;
    skos:definition "An organization that produces airplanes."^^xsd:string ;
    rdfs:subClassOf BFO:0000002 .  # BFO:0000002 represents 'Continuant'

:has_Manufacturer a owl:ObjectProperty ;
    rdfs:label "has Manufacturer"^^xsd:string ;
    skos:definition "Relates an airplane to its manufacturer."^^xsd:string ;
    rdfs:domain :Airplane ;
    rdfs:range :Manufacturer .


# Task 2 - include `Test Process`, `is temporal part of`, `is measurement unit of`, `prescribes`, `Measurement Unit`
:Test_Process a owl:Class ;
    rdfs:label "Test Process"^^xsd:string ;
    skos:definition "A process carried out to evaluate the performance characteristics of an aircraft."^^xsd:string ;
    rdfs:subClassOf BFO:0000015 .   # BFO:0000015 represents 'Process'

:is_temporal_part_of a owl:ObjectProperty ;
    rdfs:label "is temporal part of"^^xsd:string ;
    skos:definition "Relates a process to the larger process of which it is a temporal part."^^xsd:string ;
    rdfs:domain BFO:0000015 ; # BFO:0000015 represents 'Process'
    rdfs:range BFO:0000015 .  

:Approach_Measurement a owl:Class ;
    rdfs:label "Approach Measurement"^^xsd:string ;
    skos:definition "A specific type of test process that measures the approach performance of an aircraft."^^xsd:string ;
    rdfs:subClassOf BFO:0000015 . # BFO:0000015 represents 'Process'

:Measurement_Unit a owl:Class ;
    rdfs:label "Measurement Unit"^^xsd:string ;
    skos:definition "A standard unit of measurement used to quantify properties of an aircraft."^^xsd:string ;
    rdfs:subClassOf BFO:0000031 .  # BFO:0000031 represents 'Generically Dependent Continuant'

:is_measurement_unit_of a owl:ObjectProperty ;
    rdfs:label "is measurement unit of"^^xsd:string ;
    skos:definition "Relates a measurement unit to the property it measures."^^xsd:string ;
    rdfs:domain :Measurement_Unit ;
    rdfs:range :Approach_Measurement .

:prescribes a owl:ObjectProperty ;
    rdfs:label "prescribes"^^xsd:string ;
    skos:definition "Relates specifications to the test process results they prescribe."^^xsd:string ;
    rdfs:domain :Artifact_Design ;
    rdfs:range :Approach_Measurement .


#Task 3 - include `Act of Aircraft Processing`, `Adaptability Evaluation`, `is about`, `realizes`, `is output of`, `Artifact Design`, `inheres in`
:Act_of_Aircraft_Processing a owl:Class ;
    rdfs:label "Act of Aircraft Processing"^^xsd:string ;
    skos:definition "A specific act that involves processing an aircraft, such as testing or evaluation."^^xsd:string ;
    rdfs:subClassOf BFO:0000015 .  # BFO:0000015 represents 'Process' .

:Adaptability_Evaluation a owl:Class ;
    rdfs:label "Adaptability Evaluation"^^xsd:string ;
    skos:definition "A realizable entity that assesses the adaptability of an aircraft to different conditions or requirements."^^xsd:string ;
    rdfs:subClassOf BFO:0000017 . # BFO:0000017 represents 'Realizable Entity'

:realizes a owl:ObjectProperty ;
    rdfs:label "realizes"^^xsd:string ;
    skos:definition "Relates a process to the entity it realizes."^^xsd:string .

:is_output_of a owl:ObjectProperty ;
    rdfs:label "is output of"^^xsd:string ;
    skos:definition "Relates an entity to the process that produced it."^^xsd:string .

:inheres_in a owl:ObjectProperty ;
    rdfs:label "inheres in"^^xsd:string ;
    skos:definition "Relates a dependent entity to the entity it depends on."^^xsd:string .







